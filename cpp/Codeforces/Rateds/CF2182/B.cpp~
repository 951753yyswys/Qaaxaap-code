#include<bits/stdc++.h>
#define int long long
using namespace std;
namespace Qaaxaap
{
	void work()
	{
		int t;
		cin>>t;
		while(t--)
		{
			int a,b;
			cin>>a>>b;
			int ans=0,lst=1;
			if(a>b) swap(a,b);
			bool flag=0;
			while(1)
			{
				flag^=1;
				if(flag)
				{
					if(a-lst>=0) a-=lst,ans++;
					else break;
				}
				else 
				{
					if(b-lst>=0) b-=lst,ans++;
					else break;
				}
				lst<<=1;
			}
			cout<<ans<<endl;
		}
	}
}
signed main()
{
	ios::sync_with_stdio(false);
	cin.tie(nullptr),cout.tie(nullptr);
	return Qaaxaap::work(),0;
}
