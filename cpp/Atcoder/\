#include<bits/stdc++.h>
#define int long long
using namespace std;
namespace Qaaxaap
{
	bool cmp(pair<int,int> a,pair<int,int> b)
	{
		return a.first+a.second<b.first+b.second;
	}
	void work()
	{
		int t;
		cin>>t;
		while(t--)
		{
			int n;
			cin>>n;
			vector<pair<int,int>> a(n);
			for(auto &tmp:a) cin>>tmp.first>>tmp.second;
			sort(a.begin(),a.end(),cmp);
			vector<int> pre(n),suf(n+1);
			pre[0]=a[0].second;
			suf[n-1]=a[n-1].first;
			for(int i=1;i<n;i++) pre[i]=pre[i-1]+a[i].second;
			for(int i=n-2;i>=0;i--) suf[i]=suf[i+1]+a[i].first;
			int ans=0;
			for(int i=0;i<n-1;i++) 
			{
				if(pre[i]<=suf[i+1]) 
				{
					ans=i+1;
					break;
				}
			}
			cout<<ans<<endl;
		}
	}
}
signed main()
{
	ios::sync_with_stdio(false);
	cin.tie(nullptr),cout.tie(nullptr);
	return Qaaxaap::work(),0;
}

