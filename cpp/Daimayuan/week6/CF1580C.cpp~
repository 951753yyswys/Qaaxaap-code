#include<bits/stdc++.h>
#define int long long
using namespace std;
namespace Qaaxaap
{
	void work()
	{
		int n,m,ans=0;
		cin>>n>>m;
		int sqr=sqrt(m);
		vector<int> prf(m+1),x(n+1),y(n+1),lst(n+1);
		vector<vector<int>> crl(sqr+2,vector<int>(sqr+2));
		for(int i=1;i<=n;i++) cin>>x[i]>>y[i];
		for(int t=1;t<=m;t++)
		{
			int opt,id;
			cin>>opt>>id;
			if(opt==1)
			{
				lst[id]=t;
				if(x[id]+y[id]>sqr) 
				{
					int j=t;
					while(j<=m)
					{
						j+=x[id];
						if(j>m) break;
						prf[j]++;
						j+=y[id];
						if(j>m) break;
						prf[j]--;
					}
				}
				else 
				{
					int tmp=x[id]+y[id];
					crl[tmp][t%tmp]--;
					crl[tmp][(t+x[id])%tmp]++;
					ans++;
				}
			}
			else 
			{
				int tmp=x[id]+y[id],tmp1=t-lst[id];
				if(tmp1%tmp>x[id]||tmp1%tmp==0) ans--;
				if(x[id]+y[id]>sqr)
				{
					int j=lst[id];
					while(j<=m)
					{
						j+=x[id];
						if(j>m) break;
						prf[j]--;
						j+=y[id];
						if(j>m) break;
						prf[j]++;
					}
				}
				else crl[tmp][lst[id]%tmp]++,crl[tmp][(lst[id]+x[id])%tmp]--;
			}
			ans+=prf[t];
			for(int i=1;i<=sqr;i++) ans+=crl[i][t%i];
			cout<<ans<<endl;
		}
	}	
}
signed main()
{
	ios::sync_with_stdio(false);
	cin.tie(nullptr),cout.tie(nullptr);
	return Qaaxaap::work(),0;
}

