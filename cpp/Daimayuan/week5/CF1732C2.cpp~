#include<bits/stdc++.h>
#define int long long
using namespace std;
namespace Qaaxaap
{
	void work()
	{
		int t;
		cin>>t;
		while(t--)
		{
			int n,q;
			cin>>n>>q;
			vector<int> sum(n+1),xum(n+1),a(n+1),b;
			b.push_back(INT_MIN);
			for(int i=1;i<=n;i++) 
			{
				cin>>a[i];
				sum[i]=sum[i-1]+a[i];
				xum[i]=xum[i-1]^a[i];
				if(a[i]) b.push_back(i);
			}
			while(q--)
			{
				int l,r,ansl,ansr;
				cin>>l>>r;
				ansl=ansr=l;
				int ans=INT_MAX,mx=sum[r]-sum[l-1]-(xum[r]^xum[l-1]);
				cout<<"/"<<mx<<endl;
				l=lower_bound(b.begin(),b.end(),l)-b.begin();
				r=upper_bound(b.begin(),b.end(),r)-b.begin()-1;
				//cout<<' '<<l<<' '<<r<<endl;
				for(int i=0;i<=30;i++) for(int j=0;j<=30;j++)
				{
					int lt=i+l,rt=r-j;
					if(lt>rt) continue;
					lt=b[lt];
					rt=b[rt];
					cout<<' '<<lt<<' '<<rt<<' '<<sum[rt]-sum[lt-1]-(xum[rt]^xum[lt-1])<<endl;
					if(sum[rt]-sum[lt-1]-(xum[rt]^xum[lt-1])==mx) if(ans>r-l+1) ansl=lt,ansr=rt,ans=r-l+1;
				}
				cout<<ansl<<' '<<ansr<<endl;
			}
		}
	}
}
signed main()
{
	ios::sync_with_stdio(false);
	cin.tie(nullptr),cout.tie(nullptr);
	return Qaaxaap::work(),0;
}
